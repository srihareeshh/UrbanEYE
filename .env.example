# ==========================================
# ALCHEMINDS POSTGRESQL ENVIRONMENT CONFIG
# ==========================================

# Port for the Express backend API server
PORT=3001

# PostgreSQL Connection String (supports local, Docker, Supabase, Neon, Render, AWS RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alcheminds

# If using SQLAlchemy / asyncpg style URLs:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/alcheminds

# Database Connection Pool Settings
PG_MAX_CLIENTS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# SSL Configuration (set to true for Supabase / Neon / Render cloud databases)
PG_SSL=false
