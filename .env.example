# ==========================================
# ALCHEMINDS / URBANEYE ENVIRONMENT CONFIG
# ==========================================

# Port for the Express backend API server
PORT=3001

# PostgreSQL Connection String (supports local, Docker, Supabase, Neon, Render, AWS RDS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/alcheminds

# Database Connection Pool Settings
PG_MAX_CLIENTS=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000

# SSL Configuration (set to true for Supabase / Neon / Render cloud databases)
PG_SSL=false

# ==========================================
# GEMINI CIVIC INTELLIGENCE & RATE CONTROLS
# ==========================================
# Backend-only Gemini API key (never exposed to frontend/browser/mobile)
GEMINI_API_KEY=YOUR_ACTUAL_API_KEY
GEMINI_MODEL=gemini-3.1-flash-lite

# Application-level rate limit guards (conservative safety targets)
GEMINI_RPM_LIMIT=6
GEMINI_TPM_LIMIT=150000
GEMINI_DAILY_REQUEST_LIMIT=1000
GEMINI_DAILY_TOKEN_LIMIT=2000000

# Concurrency & Request Spacing
GEMINI_MAX_CONCURRENCY=1
GEMINI_MIN_REQUEST_INTERVAL_MS=10000

# Token Budgets
GEMINI_MAX_INPUT_TOKENS=2048
GEMINI_MAX_OUTPUT_TOKENS=1024

# Retry & Circuit Breaker Policies
GEMINI_MAX_RETRIES=4
GEMINI_INITIAL_BACKOFF_MS=2000
GEMINI_MAX_BACKOFF_MS=16000
GEMINI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
GEMINI_CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Policy & AI Schema Versions
AI_ANALYSIS_VERSION=v1
PRIORITY_POLICY_VERSION=v1.0
